digraph ParseTree {
  graph [ordering=out, nodesep=0.3, ranksep=0.45, fontname="Helvetica", labelloc=t, label="id+id*id  (CNF)"];
  node [fontname="Helvetica", fontsize=13];
  edge [arrowhead=none, color="#555555"];
  n0 [label="E0", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n1 [label="E", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n2 [label="E", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n3 [label="id", shape=box, style="rounded,filled", fillcolor="#FDE7C8", color="#C98A2B"];
  n2 -> n3;
  n1 -> n2;
  n4 [label="E0_1", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n5 [label="T_PLUS", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n6 [label="+", shape=box, style="rounded,filled", fillcolor="#FDE7C8", color="#C98A2B"];
  n5 -> n6;
  n4 -> n5;
  n7 [label="E", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n8 [label="id", shape=box, style="rounded,filled", fillcolor="#FDE7C8", color="#C98A2B"];
  n7 -> n8;
  n4 -> n7;
  n1 -> n4;
  n0 -> n1;
  n9 [label="E0_2", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n10 [label="T_STAR", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n11 [label="*", shape=box, style="rounded,filled", fillcolor="#FDE7C8", color="#C98A2B"];
  n10 -> n11;
  n9 -> n10;
  n12 [label="E", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n13 [label="id", shape=box, style="rounded,filled", fillcolor="#FDE7C8", color="#C98A2B"];
  n12 -> n13;
  n9 -> n12;
  n0 -> n9;
  { rank=same; n3 n6 n8 n11 n13 }
}