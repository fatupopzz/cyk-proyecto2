digraph ParseTree {
  graph [ordering=out, nodesep=0.3, ranksep=0.45, fontname="Helvetica", labelloc=t, label="(id+id)*id  (CNF)"];
  node [fontname="Helvetica", fontsize=13];
  edge [arrowhead=none, color="#555555"];
  n0 [label="E0", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n1 [label="F", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n2 [label="T_LPAR", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n3 [label="(", shape=box, style="rounded,filled", fillcolor="#FDE7C8", color="#C98A2B"];
  n2 -> n3;
  n1 -> n2;
  n4 [label="E0_1", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n5 [label="E", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n6 [label="T", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n7 [label="id", shape=box, style="rounded,filled", fillcolor="#FDE7C8", color="#C98A2B"];
  n6 -> n7;
  n5 -> n6;
  n8 [label="X", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n9 [label="T_PLUS", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n10 [label="+", shape=box, style="rounded,filled", fillcolor="#FDE7C8", color="#C98A2B"];
  n9 -> n10;
  n8 -> n9;
  n11 [label="T", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n12 [label="id", shape=box, style="rounded,filled", fillcolor="#FDE7C8", color="#C98A2B"];
  n11 -> n12;
  n8 -> n11;
  n5 -> n8;
  n4 -> n5;
  n13 [label="T_RPAR", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n14 [label=")", shape=box, style="rounded,filled", fillcolor="#FDE7C8", color="#C98A2B"];
  n13 -> n14;
  n4 -> n13;
  n1 -> n4;
  n0 -> n1;
  n15 [label="Y", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n16 [label="T_STAR", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n17 [label="*", shape=box, style="rounded,filled", fillcolor="#FDE7C8", color="#C98A2B"];
  n16 -> n17;
  n15 -> n16;
  n18 [label="F", shape=ellipse, style=filled, fillcolor="#DCE8FA", color="#3D6CB3"];
  n19 [label="id", shape=box, style="rounded,filled", fillcolor="#FDE7C8", color="#C98A2B"];
  n18 -> n19;
  n15 -> n18;
  n0 -> n15;
  { rank=same; n3 n7 n10 n12 n14 n17 n19 }
}